# Template konfigurasi Study Guardian.
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Berkas .env TIDAK di-commit (lihat .gitignore).

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=study_guardian
DB_USER=postgres
DB_PASSWORD=postgres

# --- Kamera ---
# Index webcam (0 = kamera default). Ubah bila pakai kamera lain.
CAMERA_INDEX=0

# --- Model MediaPipe Pose Landmarker (Tasks API) ---
# Default: models/pose_landmarker_lite.task. Isi hanya jika model di lokasi lain.
# POSE_MODEL_PATH=models/pose_landmarker_lite.task
